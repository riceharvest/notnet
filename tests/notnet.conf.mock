# notnet test config - mock C2 + spread testing
irc_server=mock-irc
irc_port=6667
http_server=mock-http
http_port=8080
scan_interval=1
heartbeat_interval=5
scan_timeout_ms=50
scan_max_hosts=5
ssh_enabled=1
telnet_enabled=1
redis_enabled=1
scan_targets=192.168.1.0/24
# Spread targets for mock services
spread_targets=mock-ssh:22,mock-redis:6379
