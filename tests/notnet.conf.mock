# notnet test config - mock C2 + spread testing
irc_server=mock-irc
irc_port=6667
irc_auth_nicks=mockirc
http_server=mock-http
http_port=8080
c2_secret=mocksecret
scan_interval=1
heartbeat_interval=5
scan_timeout_ms=50
scan_max_hosts=5
ssh_enabled=1
telnet_enabled=1
redis_enabled=1
redis_ssh_key=ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQDMockTestKeyForNotnetRedisVector1234567890abcdefghijklmnopqrstuvwxyz notnet-test
scan_targets=192.168.1.0/24
