# notnet sim — Suricata rules (#131). Signatures for the bot's traffic,
# mirroring the log-watcher's CVE-EXPLOIT / BRUTE-BURST classes.

# ── CVE-2017-17215 (HG532 TR-064 SOAP on 37215) ──
alert tcp any any -> any 37215 (msg:"notnet CVE-EXPLOIT HG532 DeviceUpgrade SOAP"; flow:to_server,established; content:"POST /ctrlt/DeviceUpgrade_1"; content:"SOAPAction|3a|"; content:"DeviceUpgrade"; classtype:attempted-admin; sid:1000001; rev:1;)

# ── CVE-2021-35395 (Realtek Boa formSysCmd on 80) ──
alert tcp any any -> any 80 (msg:"notnet CVE-EXPLOIT Realtek formSysCmd"; flow:to_server,established; content:"POST /boafrm/formSysCmd"; content:"sysCmd="; classtype:attempted-admin; sid:1000002; rev:1;)

# ── TBK DVR device.rsp injection on 80 ──
alert tcp any any -> any 80 (msg:"notnet CVE-EXPLOIT TBK DVR device.rsp"; flow:to_server,established; content:"/device.rsp"; content:"___S_O_S_T_R_E_A_MAX___"; classtype:attempted-admin; sid:1000003; rev:1;)

# ── BRUTE-BURST: >40 new connections to one destination in 30s ──
alert tcp any any -> any any (msg:"notnet BRUTE-BURST scan/burst"; flow:to_server; flags:S; threshold:type both, track by_dst, count 40, seconds 30; classtype:misc-attack; sid:1000004; rev:1;)
