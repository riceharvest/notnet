# notnet sim — autonomous scenario (S2): IRC+HTTP+WS ALL disabled so the main
# loop's LIVE-connection gate opens (the #95/#106 rule: a bot whose C2 is down
# on every channel falls back to autonomous spreading) and spread_local() runs.
# http_server is set so the drop URL (built from c2_http.server) resolves to
# the sim payload server even though HTTP C2 itself is disabled. Scan targets
# the IoT segment.
http_enabled=0
irc_enabled=0
http_server=c2
http_port=8080
http_path=/api/v1/bot
ws_server=c2-ws
ws_port=8081
ws_enabled=0
c2_secret=mocksecret
heartbeat_interval=2
scan_interval=1
scan_timeout_ms=50
scan_max_hosts=254
ssh_enabled=1
telnet_enabled=1
smb_enabled=1
redis_enabled=1
rdp_enabled=1
persist_enabled=0
scan_targets=172.29.10.0/24
