# notnet sim — REAL mainstream services image (Tier 1, issue #123).
# One image, env-configurable: real OpenSSH, Redis, Samba, telnetd, nginx.
# The container also pre-places /etc/notnet.conf so the REAL payload runs
# and joins the C2 when the device is cracked (real end-to-end infection).
# #324: digest-pinned — floating base-image tags rebuild upstream
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
# official busybox carries the telnetd + login applets; use the static
# musl build so it runs on bookworm (the glibc build needs GLIBC 2.38+)
COPY --from=busybox:1.36-musl@sha256:3c6ae8008e2c2eedd141725c30b20d9c36b026eb796688f88205845ef17aa213 /bin/busybox /usr/local/bin/busybox-iot

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      openssh-server openssh-client redis-server samba inetutils-telnetd \
      nginx wget ca-certificates procps iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /data/share /var/www/html \
    && echo "notnet realsvc" > /var/www/html/index.html \
    && rm -f /bin/login /usr/bin/login \
    && ln -s /usr/local/bin/busybox-iot /bin/login

COPY start-realsvc.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

# NOTE (#297): intentionally NO non-root USER here. The real daemons this
# image runs need root as configured: sshd requires it for privilege
# separation, nginx/Samba bind privileged ports (80/445), and the busybox
# telnetd login shim must be root to hand out sessions. Breaking that would
# defeat the real-service parity goal (#123).
EXPOSE 22 23 80 445 6379
ENTRYPOINT ["/usr/local/bin/start.sh"]
