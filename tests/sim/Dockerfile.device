# notnet sim — device image (infection-capable victims)
# Runs the generic multi-service device emulator. Payload execution needs
# wget + a shell; /etc/notnet.conf is baked so an executed payload joins C2
# with bot_tag=<device-id>.
FROM python:3.11-slim@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7

RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY tests/sim/device.py /app/device.py
# The payload binary (real compiled notnet) is baked so the device can run it
# without depending on the C2 serving it — but the drop command uses wget, so
# we also keep the binary available at the same path wget would write.
COPY notnet /app/notnet

# Per-device config template (bot_tag substituted by gen_fleet.py)
# Real devices copy this into /etc/notnet.conf at boot via entrypoint.
COPY tests/sim/conf/notnet.conf.device.tpl /app/notnet.conf.tpl
COPY tests/sim/device_entrypoint.sh /app/device_entrypoint.sh
RUN chmod +x /app/device_entrypoint.sh

# Non-root like the bot images (#297): device.py writes persist.sh and the
# dropped payload under /app, so /app is chowned; /etc/notnet.conf is
# pre-created writable so the entrypoint can render it as this user (the
# executed payload only needs to read it); /evidence is a host bind mount.
RUN touch /etc/notnet.conf && chown -R 1000:1000 /app /etc/notnet.conf

USER 1000:1000

WORKDIR /app
ENTRYPOINT ["/app/device_entrypoint.sh"]
